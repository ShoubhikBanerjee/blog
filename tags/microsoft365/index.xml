&lt;th style="text-align: left"&gt;Feature&lt;/th&gt;
&lt;th style="text-align: left"&gt;Description&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;SharePoint News&lt;/td&gt;
&lt;td style="text-align: left"&gt;Ability to cross-post to Viva Engage&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;Teams Workflows&lt;/td&gt;
&lt;td style="text-align: left"&gt;A new form trigger&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;Viva Engage&lt;/td&gt;
&lt;td style="text-align: left"&gt;Reduced email notifications&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;Teams&lt;/td&gt;
&lt;td style="text-align: left"&gt;Lobby visibility updates&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;PowerPoint Copilot&lt;/td&gt;
&lt;td style="text-align: left"&gt;Two new skills&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;Teams&lt;/td&gt;
&lt;td style="text-align: left"&gt;Centralized channel notification settings&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;Viva Engage&lt;/td&gt;
